<!-- Generic task view: every script in an area becomes a form. Layout only; wiring in Start-M365Gui.ps1. -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="{StaticResource ContainerPadding}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Task list -->
    <Border Style="{StaticResource Card}" Margin="0,0,20,0" Padding="0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="20,20,20,12">
          <TextBlock x:Name="AreaTitle" Style="{StaticResource Subhead}" Text="Tasks"/>
          <TextBlock x:Name="AreaSubtitle" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Text=""/>
        </StackPanel>
        <ListBox x:Name="TaskList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavItem}" Margin="8,0,8,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource BodyText}" FontWeight="Medium" FontSize="14" Text="{Binding Name}"/>
                  <Border Style="{Binding ChipStyle}" Margin="8,0,0,0" Padding="8,2">
                    <TextBlock Style="{Binding ChipTextStyle}" Text="{Binding Kind}"/>
                  </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="{Binding Synopsis}" TextTrimming="CharacterEllipsis" MaxWidth="260" HorizontalAlignment="Left"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Task detail and form -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource OverlineText}" Text="Client (prefills tenant fields)"/>
            <ComboBox x:Name="ClientPicker" MinHeight="38" FontSize="14" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
        <Border x:Name="DetailCard" Style="{StaticResource Card}">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="TaskTitle" Style="{StaticResource Subhead}" Text="Pick a task"/>
              <Border x:Name="StatusChip" Grid.Column="1" Style="{StaticResource Chip}" VerticalAlignment="Center"><TextBlock x:Name="StatusChipText" Style="{StaticResource ChipText}" Text=""/></Border>
            </Grid>
            <TextBlock x:Name="TaskSynopsis" Style="{StaticResource BodyText}" Text="Every script in this area is listed on the left. Pick one, fill in the form, and Prepare writes the exact command into the review box below."/>
            <TextBlock x:Name="TaskDescription" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" Text=""/>
            <TextBlock x:Name="TaskRequires" Style="{StaticResource CaptionText}" Margin="0,8,0,0" Text=""/>
          </StackPanel>
        </Border>
        <Border x:Name="FormCard" Style="{StaticResource Card}" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="Parameters"/>
            <StackPanel x:Name="FormHost"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button x:Name="PrepareButton" Style="{StaticResource PrimaryButton}" Content="Prepare command"/>
              <Button x:Name="ExampleButton" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Content="Show example"/>
            </StackPanel>
            <TextBlock x:Name="FormHint" Style="{StaticResource CaptionText}" Margin="0,8,0,0" Text="Lists take comma-separated values. Switches are on when checked. Empty fields are left out of the command."/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
