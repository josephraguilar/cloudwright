    "clientAliasPattern": "{shortName}.clients@msp.example",
    "supportEmail": "support@msp.example",
    "supportPhone": "+1-202-555-0100",
    "supportPhone24x7": "+1-202-555-0199",
    "address": "123 Example Street, Example City, NY 10000",
    "clientNotificationsDl": "Client Notifications"
  },
  "partner": {
    "_comment": "Partner Center settings. Replace tenantId with your partner tenant GUID. gdapTemplate names the local role template under config/.",
