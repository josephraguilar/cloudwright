    "gdapTemplate": "gdap-roles.local.json",
    "approvalPollSeconds": 20,
    "approvalTimeoutMinutes": 30
  },
  "breakGlass": {
    "upnPrefix": "breakglass",
    "displayName": "Emergency Access",
    "passwordLength": 64,
    "excludeFromConditionalAccess": true
