  "adminAccounts": [
    {
      "upnPrefix": "mspadmin",
      "displayName": "Example MSP Admin",
      "roles": [
        "Global Administrator"
      ]
    }
  ],
  "distributionLists": {
    "it": "IT",
    "alerts": "MSPalerts"
