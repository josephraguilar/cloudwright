{
  "_comment": "Copy to config/msp.settings.local.json (gitignored) and fill in. Values in <angle brackets> are placeholders and fail validation until replaced. clientAliasPattern: {shortName} is replaced per client; the tech confirms the final alias in the client config.",
  "msp": {
    "name": "Example MSP",
    "shortName": "MSP",
    "homeTenantId": "examplemsp.onmicrosoft.com",
    "adminUpn": "<your-partner-account@msp.example>",
